# scripts/setup.sh creates .env with random secrets and your host UID/GID.
# Change the port if 8080 is already occupied. Only localhost is exposed.
APP_PORT=8080
LOCAL_UID=1000
LOCAL_GID=1000
# Local development only: CakePHP's diagnostic welcome page needs debug enabled.
CAKE_DEBUG=true
SECURITY_SALT=replace-with-random-64-character-hex
MYSQL_DATABASE=cakephp
MYSQL_USER=cakephp
MYSQL_PASSWORD=replace-with-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-password
# Database hostname is always the Compose service name 'db', internal port 3306.
# MySQL initialization variables apply only when its volume is empty.
